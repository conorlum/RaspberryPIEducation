[Unit]
Description=RACHEL portal (Flask via gunicorn)
After=network.target
# No limit on restart attempts - this Pi runs unattended with unreliable
# power, so a crash-loop must keep retrying forever rather than giving up
# and staying down (the default StartLimitBurst=5-in-10s would do exactly
# that, with nobody there to run `systemctl restart` afterward).
StartLimitIntervalSec=0

[Service]
Type=simple
User=@APP_USER@
WorkingDirectory=@APP_DIR@
ExecStart=@APP_DIR@/.venv/bin/gunicorn --bind 127.0.0.1:5000 --workers 2 --threads 8 --worker-class gthread --max-requests 500 --max-requests-jitter 50 app.app:app
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
