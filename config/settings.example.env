# Copy this file to settings.env and adjust for this Pi's deployment.
# settings.env is gitignored, so each Pi can keep its own values while the
# code that reads them (app/app.py, setup/hotspot.sh) stays identical.

# Shown on the landing page.
PORTAL_TITLE=RACHEL

# WiFi hotspot broadcast by this Pi (used by setup/hotspot.sh).
WIFI_SSID=RACHEL
WIFI_PASSWORD=changeme123

# Where nginx proxies /kiwix/* to (kiwix-serve's own port). Also used
# directly by Flask (server-side, bypassing nginx) to call kiwix-serve's
# /suggest endpoint for the /library page's live search.
KIWIX_PORT=8080

# URL prefix kiwix-serve is told to run under (its own --urlRootLocation
# flag - see setup/systemd/kiwix-serve.service) and that nginx preserves
# when proxying /kiwix/* (see setup/nginx/rachel.conf). kiwix-serve needs to
# know its own sub-path so its self-generated links (content/search/viewer)
# come out correct instead of 404ing - this is what was broken both in
# kiwix-serve's original stock UI and in this app's first /library cut.
# Keep this in sync with the nginx location block and the systemd unit if
# you ever change the mount path.
KIWIX_URL_ROOT=/kiwix

# Port gunicorn binds the Flask app to internally (nginx proxies to this).
PORTAL_PORT=5000

# Max search results shown per ZIM on the /library page. Kept low so one
# large ZIM (e.g. a full Wikipedia dump) can't flood out results from
# smaller ones - kiwix-serve's own /suggest ranking picks the top N.
RESULTS_PER_ZIM=5

# URL template used by the /library page to link each ZIM card into
# kiwix-serve's own per-book content page. {name} is replaced with each
# book's `name` attribute from content/library.xml. Confirmed working as
# long as KIWIX_URL_ROOT above matches kiwix-serve's actual
# --urlRootLocation - otherwise kiwix-serve's own in-page links 404.
# Uses /content/ (plain server-rendered pages) rather than /viewer# (kiwix's
# JS single-page-app reader) - the latter's scroll-triggered toolbar resize
# triggers a known Chrome-for-Android bug that blocks the phone's back
# button until the user swipes instead.
KIWIX_VIEWER_URL_TEMPLATE=/kiwix/content/{name}

# Same idea as above, but for linking directly to one matching article from
# a search result. {name} is the book's name, {path} is the article path
# returned by kiwix-serve's /suggest endpoint.
KIWIX_ARTICLE_URL_TEMPLATE=/kiwix/content/{name}/{path}
