# Copy this file to settings.env and adjust for this Pi's deployment.
# settings.env is gitignored, so each Pi can keep its own values while the
# code that reads them (app/app.py, setup/hotspot.sh) stays identical.

# Shown on the landing page.
PORTAL_TITLE=RACHEL

# WiFi hotspot broadcast by this Pi (used by setup/hotspot.sh).
WIFI_SSID=RACHEL
WIFI_PASSWORD=changeme123

# Where nginx proxies /kiwix/* to (kiwix-serve's own port). Also used
# directly by Flask (server-side, bypassing nginx) to call kiwix-serve's
# /suggest endpoint for the /library page's live search.
KIWIX_PORT=8080

# Port gunicorn binds the Flask app to internally (nginx proxies to this).
PORTAL_PORT=5000

# Max search results shown per ZIM on the /library page. Kept low so one
# large ZIM (e.g. a full Wikipedia dump) can't flood out results from
# smaller ones - kiwix-serve's own /suggest ranking picks the top N.
RESULTS_PER_ZIM=5

# URL template used by the /library page to link each ZIM card into
# kiwix-serve's own per-book viewer. {name} is replaced with each book's
# `name` attribute from content/library.xml.
# ASSUMPTION: based on kiwix-tools 3.x's hash-routed viewer SPA; not yet
# confirmed on real hardware/ZIM. If library cards 404 or open the wrong
# book, adjust this single value instead of editing template/route code.
KIWIX_VIEWER_URL_TEMPLATE=/kiwix/viewer#{name}

# Same idea as above, but for linking directly to one matching article from
# a search result. {name} is the book's name, {path} is the article path
# returned by kiwix-serve's /suggest endpoint.
KIWIX_ARTICLE_URL_TEMPLATE=/kiwix/viewer#{name}/{path}
